# ---- Backend runtime ----
# 自动优先使用已有 Chroma collection；未建库时回退本地 JSON。
KNOWLEDGE_BACKEND=auto
VECTOR_BACKEND=auto
KNOWLEDGE_RETRIEVAL_MODE=dual_kb_retrieval

# ---- Chroma ----
# 统一向量库目录（兼容旧变量 CHROMA_PERSIST_DIR）
CHROMA_DIR=./storage/chroma
LAW_COLLECTION_NAME=legal_knowledge_v1
CASE_COLLECTION_NAME=case_knowledge_v1
# 建库分块参数
INGEST_CHUNK_SIZE=500
INGEST_CHUNK_OVERLAP=50

# ---- Local knowledge base (JSON fallback) ----
LEGAL_KB_PATH=./data/legal_knowledge_base.json
CASE_KB_PATH=./data/case_knowledge_base.json

# ---- Ollama generation ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=45
GENERATION_PROVIDER=ollama
GENERATION_MODEL=qwen2:0.5b
# 默认关闭 LLM/RAG，保证未配置模型时也能规则拼装演示；按需开启。
LLM_ENABLED=false
RAG_ENABLED=false

# ---- Local embedding ----
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ---- Optional OpenAI-compatible fallback ----
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- Optional Aliyun DashScope (OpenAI-compatible) ----
# 阿里云百炼密钥；GENERATION_PROVIDER=aliyun 时启用。
ALIYUN_LLM_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL=qwen-plus

# ---- Optional corpus exports ----
LAW_SOURCE_EXPORT=./storage/raw/laws.jsonl
CASE_SOURCE_EXPORT=./storage/raw/cases.jsonl

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173